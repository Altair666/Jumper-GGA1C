<?xml version="1.0" encoding="UTF-8"?>

<!-- This is the EDA configuration for the altiumPCB application. -->

<EDAClientDef xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="EDAClientDef.xsd"
              application="altiumPCB"
              family="altium"
              enableVariants="true"
              enableOpenRelatedDatasets="true"
              preserveSession="true"
              className="com.teamcenter.edabase.DefaultEDAFactory"
              supportsBaseBom="false"
              enableDoNotKeep="true"
              enableEDAUIDs="true"
              USASCIIRequired="false"
              licenseKey="ecad_gateway_all">

  <!-- Ensure "datasetType" attributes are set to correct Teamcenter types -->
  <PrimaryDataType name="pcb" datasetType="EDADesAltiumBrd">
    <Include>*</Include>
  </PrimaryDataType>

  <RelatedDataType name="schematic" datasetType="EDADesAltiumSch">
    <Include>*</Include>
  </RelatedDataType>

  <IntermediateDataType name="pcbCad" datasetType="EDAGenPCBCAD"/>

  <PreferenceDefs/>

  <CallbackDefs>
    <callback type="java" operation="postSave" command="com.altium.eis.teamcenter.eda.callback.PostSaveCallback:readPWB"/>
    <callback type="java" operation="postSaveAs" command="com.altium.eis.teamcenter.eda.callback.PostSaveCallback:readPWB"/>
    <!--
    <callback type="java" operation="preSave" command="com.altium.eis.teamcenter.eda.callback.SubstituteCallbacks:checkSubstitutes"/>
    <callback type="java" operation="preSaveAs" command="com.altium.eis.teamcenter.eda.callback.SubstituteCallbacks:checkSubstitutes"/>
    <callback type="java" operation="postSave" command="com.altium.eis.teamcenter.eda.callback.SubstituteCallbacks:updateSubstitutes"/>
    <callback type="java" operation="postSaveAs" command="com.altium.eis.teamcenter.eda.callback.SubstituteCallbacks:updateSubstitutes"/>
    -->
    <callback type="java" operation="prePreSave" command="com.altium.eis.teamcenter.eda.callback.PrePreSaveCallback:open"/>
    <callback type="java" operation="postSave" command="com.altium.eis.teamcenter.eda.callback.PostSaveCallback:checkin"/>
  </CallbackDefs>

  <RdnAttrMapDefs>
    <!-- Map Altium part_source attribute to bl_part_source BOM line attribute -->
    <RdnAttrDesign cadAttrName="part_source" tcAttrName="bl_part_source"/>
    <!-- Map Altium sequence_number attribute to bl_sequence_no bom line attribute -->
    <RdnAttrDesign cadAttrName="sequence_number" tcAttrName="bl_sequence_no"/>
  </RdnAttrMapDefs>
</EDAClientDef>
