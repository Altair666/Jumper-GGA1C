@using System.Globalization
@using GGA1C.Sync.Printing
@using GGA1C.Sync.Printing.Profiles

<div class="sync-printer-field">
    @if (Field.Kind == PrinterSettingKind.Checkbox)
    {
        <label class="sync-printer-check" for="@Id">
            <input id="@Id" type="checkbox" checked="@(Value == Field.CheckedValue)" disabled="@Disabled" @onchange="Toggle" />
            @Field.Caption
        </label>
        @if (OutsideChoice)
        {
            <small class="sync-printer-warning">@ValueText — вне списка принтера</small>
        }
    }
    else
    {
        <label for="@Id">@Field.Caption</label>
        @if (Field.Kind == PrinterSettingKind.Choice)
        {
            <select id="@Id" title="@SelectedCaption" disabled="@Disabled" @bind:get="ValueText" @bind:set="Commit">
                @if (Value is null)
                {
                    <option value="" disabled>не считано</option>
                }
                else if (OutsideChoice)
                {
                    <option value="@ValueText" disabled>@SelectedCaption</option>
                }
                @foreach (var option in Field.Choices!)
                {
                    <option value="@option.Value">@option.Caption</option>
                }
            </select>
            @if (OutsideChoice)
            {
                <small class="sync-printer-warning sync-printer-outside-note">@SelectedCaption</small>
            }
        }
        else if (Field.Kind == PrinterSettingKind.ReadOnly)
        {
            <input id="@Id" value="@($"{ValueText} {Field.Unit}")" readonly />
        }
        else
        {
            <div class="sync-native-input-unit">
                <input id="@Id" class="sync-printer-number" type="text" inputmode="@(IsLength ? "decimal" : "numeric")"
                       autocomplete="off" spellcheck="false" placeholder="@(Value is null ? "не считано" : null)"
                       data-step="@(IsLength ? "0.1" : "1")" aria-invalid="@(_error is not null ? "true" : null)"
                       aria-describedby="@($"{Id}-hint")" disabled="@Disabled" @bind:get="DisplayValue" @bind:set="Commit" />
                <span aria-hidden="true">@(IsLength ? LengthUnits.Symbol(Unit) : Field.Unit)</span>
                <PageSetupSteppers Caption="@Field.Caption" Disabled="@Disabled" />
            </div>
        }
    }
    <div id="@($"{Id}-hint")">
        @if (Field.Hint is not null)
        {
            <small>@Field.Hint</small>
        }
        @if (_error is not null)
        {
            <small class="sync-printer-error" role="alert">@_error</small>
        }
        @if (Warning is not null)
        {
            <small class="sync-printer-warning">@Warning</small>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter, EditorRequired] public PrinterSetting Field { get; set; } = default!;
    [Parameter] public double? Value { get; set; }
    [Parameter] public LengthUnit Unit { get; set; }
    [Parameter] public double DotsPerMm { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Warning { get; set; }
    [Parameter] public EventCallback<string?> ErrorChanged { get; set; }
    [Parameter] public EventCallback<double> Changed { get; set; }

    private string? _invalidText;
    private string? _error;
    private bool IsLength => Field.Kind == PrinterSettingKind.Length;
    private string ValueText => Value?.ToString("G", CultureInfo.InvariantCulture) ?? "";
    private bool OutsideChoice => Value is { } value && Field.Error(value) is not null;
    private string? SelectedCaption => OutsideChoice ? $"{ValueText} — вне списка принтера"
        : Field.Choices?.FirstOrDefault(choice => choice.Value == Value)?.Caption;
    private string DisplayValue => _invalidText ?? (IsLength && Value is { } mm
        ? PageSetupMeasurement.Format(LengthUnits.FromMillimetres(mm, Unit, DotsPerMm)) : ValueText);

    private Task Toggle(ChangeEventArgs args) => Changed.InvokeAsync(args.Value is true ? Field.CheckedValue : Field.UncheckedValue);

    private async Task Commit(string text)
    {
        if (Disabled || (text == DisplayValue && _error is null)) return;
        double value;
        if (!double.TryParse(text.Replace(',', '.'), NumberStyles.AllowLeadingSign | NumberStyles.AllowDecimalPoint,
                CultureInfo.InvariantCulture, out var parsed) || !double.IsFinite(parsed))
        {
            _error = Field.Kind == PrinterSettingKind.Integer ? "Введите целое число." : "Введите число.";
            value = 0;
        }
        else
        {
            value = IsLength ? LengthUnits.ToMillimetres(parsed, Unit, DotsPerMm) : parsed;
            // A unit conversion can place an exact displayed boundary a fraction of an ulp outside.
            if (Field.Maximum is { } max && Math.Abs(value - max) <= Math.Abs(max) * 1e-14) value = max;
            _error = Field.Error(value);
        }
        _invalidText = _error is null ? null : text;
        await ErrorChanged.InvokeAsync(_error);
        if (_error is null && value != Value) await Changed.InvokeAsync(value);
    }
}
