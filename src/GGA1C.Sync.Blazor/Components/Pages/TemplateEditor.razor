@page "/templates/{Id:int}/edit"
@attribute [Authorize(GGA1C.Sync.Permissions.SyncPermissions.Admin)]
@using GGA1C.Sync.Templates
@using GGA1C.Sync.Printing
@using GGA1C.Sync.Printing.Profiles
@using System.Text
@using System.Text.Json
@using System.Globalization
@inherits PrinterProfileComponent
@implements IAsyncDisposable
@inject IPrintTemplateEditorAppService EditorService
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime

@* П12.1п: документ в миллиметрах; при 100% — 96 CSS px на дюйм.
   Линейки закреплены у окна просмотра; координаты берутся из одной матрицы SVG. *@

@if (Model == null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    @if (SettingsOpen)
    {
        <div class="sync-settings-backdrop" role="presentation" style="position:fixed;left:0;top:0;width:100vw;height:100vh;z-index:2147483000;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.45);isolation:isolate;">
            <section class="sync-settings-window" role="dialog" aria-modal="true" aria-labelledby="sync-settings-title" @onclick:stopPropagation="true">
                <header class="sync-native-titlebar"><span id="sync-settings-title">Настройка страницы</span><button type="button" class="sync-native-close" @onclick="CancelSettings">×</button></header>
                <nav class="sync-native-tabs" aria-label="Разделы настроек">
                    <button class="@(SettingsTab == 0 ? "active" : "")" @onclick="@(() => SettingsTab = 0)">Размер носителя</button>
                    <button class="@(SettingsTab == 1 ? "active" : "")" @onclick="@(() => SettingsTab = 1)">Размещение</button>
                    <button class="@(SettingsTab == 2 ? "active" : "")" @onclick="@(() => SettingsTab = 2)">Тип бумаги</button>
                    <button class="@(SettingsTab == 3 ? "active" : "")" @onclick="@(() => SettingsTab = 3)">Печать</button>
                </nav>

                <div class="sync-native-body">
                    @if (SettingsTab == 0)
                    {
                        <div class="sync-native-left">
                            <fieldset>
                                <legend>Размер страницы</legend>
                                <div class="sync-native-measure">
                                    <PageSetupMeasurement Id="setup-page-width" IconSrc="images/golabel-page/page-width.png" Caption="Ширина страницы" Hint="@($"Максимальная ширина: {PrintTemplateConsts.MaxPageWidthMm} мм")" Unit="@SetupUnitShort" @bind-Value="SetupWidthValue" />
                                </div>
                                <div class="sync-native-measure">
                                    <PageSetupMeasurement Id="setup-page-height" IconSrc="images/golabel-page/page-height.png" Caption="Высота страницы" Unit="@SetupUnitShort" @bind-Value="SetupHeightValue" />
                                </div>
                            </fieldset>
                            <fieldset>
                                <legend>Отступы</legend>
                                <div class="sync-native-margin-grid">
                                    <div class="sync-native-measure">
                                        <PageSetupMeasurement Id="setup-margin-left" IconSrc="images/golabel-page/margin-left.png" Caption="Левое поле" Unit="@SetupUnitShort" @bind-Value="SetupLeftMarginValue" />
                                    </div>
                                    <div class="sync-native-measure">
                                        <PageSetupMeasurement Id="setup-margin-right" IconSrc="images/golabel-page/margin-right.png" Caption="Правый край" Unit="@SetupUnitShort" @bind-Value="SetupRightMarginValue" />
                                    </div>
                                    <div class="sync-native-measure">
                                        <PageSetupMeasurement Id="setup-margin-top" IconSrc="images/golabel-page/margin-top.png" Caption="Верхнее поле" Unit="@SetupUnitShort" @bind-Value="SetupTopMarginValue" />
                                    </div>
                                    <div class="sync-native-measure">
                                        <PageSetupMeasurement Id="setup-margin-bottom" IconSrc="images/golabel-page/margin-bottom.png" Caption="Нижний край" Unit="@SetupUnitShort" @bind-Value="SetupBottomMarginValue" />
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                    }
                    else if (SettingsTab == 1)
                    {
                        <div class="sync-native-left sync-native-placement">
                            <fieldset>
                                <legend>Edit Mode</legend>
                                <div class="sync-native-radio-row">
                                    <label><input type="radio" name="nativeRows" checked="@IsMultiRow" @onchange="@(() => SetMultiRow(true))" /> Многорядная печать</label>
                                    <label><input type="radio" name="nativeRows" checked="@(!IsMultiRow)" @onchange="@(() => SetMultiRow(false))" /> Однорядная печать</label>
                                </div>
                                <div class="sync-native-placement-grid">
                                    <label for="setup-print-order">Порядок печати</label>
                                    <select id="setup-print-order" @bind="SetupEdits.AcrossType" disabled="@(!IsMultiRow)">
                                        <option value="0">Копировать</option><option value="1">Слева направо</option><option value="2">Сверху вниз</option>
                                    </select>
                                    <label for="setup-count-x">Горизонтально</label>
                                    <div class="sync-native-input-unit sync-native-count-unit">
                                        <input id="setup-count-x" class="sync-setup-count" type="number" min="1" @bind="SetupEdits.HorAcross" />
                                        <PageSetupSteppers Caption="Горизонтально" />
                                    </div>
                                    <PageSetupMeasurement Id="setup-gap-x" Caption="Горизонтальный зазор" Unit="@SetupUnitShort" @bind-Value="SetupHorGapValue" />
                                    <label for="setup-count-y">Вертикальный</label>
                                    <div class="sync-native-input-unit sync-native-count-unit">
                                        <input id="setup-count-y" class="sync-setup-count" type="number" min="1" @bind="SetupEdits.VerAcross" />
                                        <PageSetupSteppers Caption="Вертикальный" />
                                    </div>
                                    <PageSetupMeasurement Id="setup-gap-y" Caption="Вертикальный зазор" Unit="@SetupUnitShort" @bind-Value="SetupVerGapValue" />
                                </div>
                            </fieldset>
                            <fieldset>
                                <legend>Форма этикетки</legend>
                                <div class="sync-native-shapes">
                                    <label><input type="radio" name="nativeShape" aria-label="Квадрат" checked="@(SetupEdits.Shape == 0)" @onchange="@(() => SetShape(0))" /><img src="images/golabel-page/shape-rectangle.png" alt="" /></label>
                                    <label><input type="radio" name="nativeShape" aria-label="Круг" checked="@(SetupEdits.Shape == 1)" @onchange="@(() => SetShape(1))" /><img src="images/golabel-page/shape-ellipse.png" alt="" /></label>
                                    <label><input type="radio" name="nativeShape" aria-label="Скруглённый квадрат" checked="@(SetupEdits.Shape == 2)" @onchange="@(() => SetShape(2))" /><img src="images/golabel-page/shape-rounded.png" alt="" /></label>
                                </div>
                                @if (SetupEdits.Shape == 2)
                                {
                                    <div class="sync-native-measure sync-setup-radius">
                                        <PageSetupMeasurement Id="setup-canvas-radius" Caption="Радиус скругления" Unit="@SetupUnitShort" @bind-Value="SetupCanvasRadiusValue" />
                                    </div>
                                }
                            </fieldset>
                        </div>
                    }
                    else if (SettingsTab == 2)
                    {
                        <div class="sync-native-left sync-native-paper-list">
                            <div class="sync-native-paper-row">
                                <img src="images/golabel-page/paper-gap.png" alt="" />
                                <label class="sync-native-paper-kind"><input type="radio" name="nativePaper" checked="@(SetupEdits.LabelType == 0)" @onchange="@(() => SetLabelType(0))" /> Этикетка с зазором</label>
                                <PageSetupMeasurement Id="setup-paper-gap" Caption="Ширина зазора" Unit="@SetupUnitShort" Disabled="@(SetupEdits.LabelType != 0)" @bind-Value="SetupGapValue" />
                            </div>
                            <div class="sync-native-paper-row">
                                <img src="images/golabel-page/paper-continuous.png" alt="" />
                                <label class="sync-native-paper-kind"><input type="radio" name="nativePaper" checked="@(SetupEdits.LabelType == 1)" @onchange="@(() => SetLabelType(1))" /> Непрерывный носитель</label>
                                <PageSetupMeasurement Id="setup-paper-continuous" Caption="Длина подачи бумаги" Unit="@SetupUnitShort" Disabled="@(SetupEdits.LabelType != 1)" @bind-Value="SetupFeedValue" />
                            </div>
                            <div class="sync-native-paper-row sync-native-paper-blackmark">
                                <img src="images/golabel-page/paper-blackmark.png" alt="" />
                                <label class="sync-native-paper-kind"><input type="radio" name="nativePaper" checked="@(SetupEdits.LabelType == 2)" @onchange="@(() => SetLabelType(2))" /> Бумага с черной отметкой</label>
                                <div class="sync-native-blackmark-fields">
                                    <PageSetupMeasurement Id="setup-mark-width" Caption="Ширина" Unit="@SetupUnitShort" Disabled="@(SetupEdits.LabelType != 2)" @bind-Value="SetupBlackMarkValue" />
                                    <PageSetupMeasurement Id="setup-mark-offset" Caption="Положение" Unit="@SetupUnitShort" Disabled="@(SetupEdits.LabelType != 2)" @bind-Value="SetupBlackMarkPositionValue" />
                                    <div class="sync-native-measure-field">
                                        <label for="setup-mark-position">Положение черной отметки</label>
                                        <select id="setup-mark-position" disabled="@(SetupEdits.LabelType != 2)" @bind="SetupBlackMarkSide">
                                            <option value="after">+ за этикеткой</option>
                                            <option value="inside">- внутри этикетки</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="sync-native-left">
                            <fieldset>
                                <legend>Настройки печати</legend>
                                @if (Profile is not null)
                                {
                                    <div class="sync-native-measure">
                                        <PrinterLengthInput Id="setup-non-printable-length" Field="NonPrintableField" Unit="Unit"
                                                            DotsPerMm="EditorPrinter.DotsPerMm" Millimetres="CanvasNonPrintableMm"
                                                            SavedMillimetres="SavedNonPrintableMm" UpdateWhileTyping="true"
                                                            Disabled="@_savingProfile" MillimetresChanged="SetNonPrintableDraft" />
                                    </div>
                                }
                                else
                                {
                                    <span>Профиль принтера недоступен.</span>
                                }
                            </fieldset>
                        </div>
                    }
                    <div class="sync-native-preview">
                        <div class="sync-native-preset-row">
                            <label>Стандарт формы этикетки
                                <select @bind="SelectedSetupPresetId" @bind:after="SelectSetupPreset" disabled="@(SetupPresetsBusy || SetupPresets.Count == 0)">
                                    <option value=""></option>
                                    @foreach (var preset in SetupPresets)
                                    {
                                        <option value="@preset.Id">@preset.Name</option>
                                    }
                                </select>
                            </label>
                            <button class="sync-preview-delete" type="button" title="Удалить стандарт формы" aria-label="Удалить стандарт формы"
                                    disabled="@(SetupPresetsBusy || SelectedSetupPresetId.Length == 0)" @onclick="ClearSetupPreset">
                                <img src="images/golabel-page/preview-delete.png" alt="" />
                            </button>
                        </div>
                        <div class="sync-native-preset-row">
                            <label>Описание<input type="text" @bind="SetupPresetName" @bind:event="oninput" disabled="@SetupPresetsBusy" /></label>
                            <button class="sync-preview-save" type="button" title="Сохранить стандарт формы" aria-label="Сохранить стандарт формы"
                                    disabled="@(SetupPresetsBusy || string.IsNullOrWhiteSpace(SetupPresetName))" @onclick="SaveSetupPreset">
                                <img src="images/golabel-page/preview-save.png" alt="" />
                            </button>
                        </div>
                        <div class="sync-preview-caption">Предварительный просмотр назначения этикетки</div>
                        <button type="button" class="sync-preview-stage" @onclick="OpenPreviewPlacement" aria-label="Открыть размещение и сменить форму">
                            <svg viewBox="0 0 252 174" width="252" height="174" aria-hidden="true">
                                <g transform="@SetupPreviewTransform">
                                    @if (SetupEdits.LabelType == 2 && SetupPreviewBlackMarkHeight > 0)
                                    {
                                        <rect class="sync-preview-blackmark" x="0" y="@PreviewNumber(SetupPreviewBlackMarkTop)"
                                              width="@PreviewNumber(SetupWidthMm)" height="@PreviewNumber(SetupPreviewBlackMarkHeight)" />
                                    }
                                    @if (SetupUsableWidthMm > 0 && SetupUsableHeightMm > 0)
                                    {
                                        @for (var row = 0; row < SetupPreviewRows; row++)
                                        {
                                            @for (var column = 0; column < SetupPreviewColumns; column++)
                                            {
                                                var x = SetupMargins.Left + column * (SetupUsableWidthMm + (SetupEdits.HorGapMm ?? 0));
                                                var y = SetupMargins.Top + row * (SetupUsableHeightMm + (SetupEdits.VerGapMm ?? 0));
                                                @if (SetupEdits.Shape == 1)
                                                {
                                                    <ellipse class="sync-preview-label" vector-effect="non-scaling-stroke"
                                                             cx="@PreviewNumber(x + SetupUsableWidthMm / 2)" cy="@PreviewNumber(y + SetupUsableHeightMm / 2)"
                                                             rx="@PreviewNumber(SetupUsableWidthMm / 2)" ry="@PreviewNumber(SetupUsableHeightMm / 2)" />
                                                }
                                                else
                                                {
                                                    <rect class="sync-preview-label" vector-effect="non-scaling-stroke" x="@PreviewNumber(x)" y="@PreviewNumber(y)"
                                                          width="@PreviewNumber(SetupUsableWidthMm)" height="@PreviewNumber(SetupUsableHeightMm)"
                                                          rx="@PreviewNumber(SetupEdits.Shape == 2 ? SetupCanvasRadiusMm : 0)" />
                                                }
                                                @if (SetupPreviewShowsPrintOrder)
                                                {
                                                    @SetupPreviewLabelNumber(column, row, x, y)
                                                }
                                            }
                                        }
                                    }
                                    <rect class="sync-preview-paper" vector-effect="non-scaling-stroke" x="0" y="0"
                                          width="@PreviewNumber(SetupWidthMm)" height="@PreviewNumber(SetupHeightMm)" />
                                </g>
                            </svg>
                        </button>
                        <div class="sync-native-size"><span>Размер</span><b>@SetupDisplay(SetupWidthMm)</b><span>@SetupUnitShort</span><em>×</em><b>@SetupDisplay(SetupHeightMm)</b><span>@SetupUnitShort</span></div>
                        <div class="sync-native-size"><span>Размер этикетки</span><b>@SetupDisplay(SetupUsableWidthMm)</b><span>@SetupUnitShort</span><em>×</em><b>@SetupDisplay(SetupUsableHeightMm)</b><span>@SetupUnitShort</span></div>
                    </div>
                </div>
                <footer class="sync-native-footer">
                    @UnitCycleButton()
                    <span></span>
                    <button type="button" @onclick="CancelSettings" disabled="@_savingProfile">Отмена</button>
                    <button type="button" class="primary" @onclick="ApplySetup" disabled="@_savingProfile">ОК</button>
                </footer>
            </section>
        </div>
    }


    <div @ref="_editorRoot" data-unit="@UnitShort(Unit)" data-units-per-mm="@GeometryNumber(UnitsPerMm)"
         data-settings-open="@(SettingsOpen ? "true" : "false")">
    <MudPaper Class="pa-2 mb-2" Elevation="1">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Class="sync-editor-toolbar">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Title="К шаблонам"
                           OnClick="@(() => NavigationManager.NavigateTo("templates"))" />
            <MudText Typo="Typo.h6" Class="mb-0">@Model.Name</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                @FormatNumber(Model.WidthMm) × @FormatNumber(Model.HeightMm) mm · @(Math.Round(Model.Dpi)) dpi ·
                @Model.FileName (@(Model.Size / 1024) КБ)
            </MudText>
            <MudSpacer />
            <div class="sync-editor-zoom" role="group" aria-label="Масштаб холста">
                <input type="range" id="sync-zoom" min="0.1" max="6" step="0.01" value="1" aria-label="Масштаб холста" />
                <button type="button" id="sync-zoom-reset" title="Вернуть масштаб 100 % и исходное положение">100 %</button>
                <button type="button" id="sync-zoom-fit" title="Показать наклейку целиком">Вписать</button>
            </div>
            <span id="sync-pos-readout" class="sync-pos-readout">—</span>
            <MudSwitch T="bool" @bind-Value="ShowHidden" Label="Скрытые" Color="Color.Primary" />
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@Busy"
                       StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">Сохранить</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@Busy"
                       StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadAsync">Скачать</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@Busy" StartIcon="@Icons.Material.Filled.Settings" OnClick="OpenSettings">Настройки страницы</MudButton>
        </MudStack>
    </MudPaper>

    <div class="sync-editor-body">
        <div class="sync-workspace" id="sync-workspace">
            @UnitCycleButton("sync-ruler-corner")
            <svg id="sync-ruler-top" class="sync-ruler sync-ruler-top" aria-hidden="true">
                <g class="sync-ruler-scale"></g>
                <line class="sync-ruler-marker" visibility="hidden" />
            </svg>
            <svg id="sync-ruler-left" class="sync-ruler sync-ruler-left" aria-hidden="true">
                <g class="sync-ruler-scale"></g>
                <line class="sync-ruler-marker" visibility="hidden" />
            </svg>
            <div id="sync-viewport" class="sync-viewport" tabindex="0" role="region" aria-label="Рабочая область наклейки">
                <div class="sync-canvas-stage sync-canvas-stage-docked">
                    <svg id="sync-canvas-svg" class="sync-canvas sync-canvas-sheet" aria-label="Макет наклейки"
                         data-non-printable-mm="@GeometryNumber(CanvasNonPrintableMm)"
                         preserveAspectRatio="none"
                         viewBox="@GeometryNumber(-CanvasNonPrintableMm) 0 @GeometryNumber(CanvasWidthMm + CanvasNonPrintableMm) @GeometryNumber(CanvasHeightMm)"
                         width="@GeometryNumber(PxPerMm * (CanvasWidthMm + CanvasNonPrintableMm))" height="@GeometryNumber(PxPerMm * CanvasHeightMm)">
                        @if (CanvasNonPrintableMm > 0)
                        {
                            <rect class="sync-canvas-unprintable" x="@GeometryNumber(-CanvasNonPrintableMm)" y="0"
                                  width="@GeometryNumber(CanvasNonPrintableMm)" height="@GeometryNumber(CanvasHeightMm)" />
                        }
                        @if (CanvasShape == 1)
                        {
                            <ellipse class="sync-canvas-paper" cx="@GeometryNumber(CanvasWidthMm / 2)" cy="@GeometryNumber(CanvasHeightMm / 2)"
                                     rx="@GeometryNumber(CanvasWidthMm / 2)" ry="@GeometryNumber(CanvasHeightMm / 2)" />
                        }
                        else
                        {
                            <rect class="sync-canvas-paper" width="@GeometryNumber(CanvasWidthMm)" height="@GeometryNumber(CanvasHeightMm)"
                                  rx="@GeometryNumber(CanvasShape == 2 ? RadiusMm(ActiveCanvasOptions, CanvasWidthMm, CanvasHeightMm) : 0)" />
                        }
                        <g class="sync-canvas-objects">@((MarkupString)ShapesSvg())</g>
                    </svg>
                </div>
            </div>
            <svg id="sync-crosshair" class="sync-crosshair" aria-hidden="true">
                <line class="sync-cross" visibility="hidden" />
                <line class="sync-cross" visibility="hidden" />
            </svg>
        </div>

        <div class="sync-editor-side">
            <MudPaper Class="pa-2" Elevation="1">
                <MudText Typo="Typo.subtitle2" Class="mb-1">Объекты</MudText>
                <MudList T="int?" @bind-SelectedValue="SelectedIndex" Dense="true" Class="sync-editor-list" Style="max-height:34vh;overflow:auto;">
                    @foreach (var shape in Model.Shapes)
                    {
                        <MudListItem T="int?" Value="@shape.Index">
                            <MudText Typo="Typo.caption">
                                @shape.Index. @shape.KindCaption@(shape.IsPrint ? "" : " · скрыт")
                            </MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-family:monospace;">
                                @ShortData(shape)
                            </MudText>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>

            <MudPaper Class="pa-2 mt-2" Elevation="1">
                @if (Selected == null)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Выберите объект — здесь его описание и свойства в единицах линейки.
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.subtitle2">№ @Selected.Index · @Selected.KindCaption</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">
                        тип: @Selected.TypeName@(Selected.IsPrint ? "" : " · скрыт")
                    </MudText>

                    <MudNumericField T="double" Label="@UnitLabel("X")" @bind-Value="EditsX"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Class="mb-1" />
                    <MudNumericField T="double" Label="@UnitLabel("Y")" @bind-Value="EditsY"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Class="mb-1" />
                    @if (Selected.Width != null)
                    {
                        <MudNumericField T="double" Label="@UnitLabel("Ширина")" @bind-Value="EditsWidth"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Class="mb-1" />
                        <MudNumericField T="double" Label="@UnitLabel("Высота")" @bind-Value="EditsHeight"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Class="mb-1" />
                    }
                    <MudTextField T="string" Label="Данные" @bind-Value="Selected.Data" Lines="3"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-1" />
                    <MudSwitch T="bool" @bind-Value="Selected.IsPrint" Label="Печатать этот объект"
                               Color="Color.Primary" Class="mb-1" />

                    @if (Selected.IsRaster)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@Busy" FullWidth="true"
                                   OnClick="RebuildRasterAsync">Пересобрать картинку</MudButton>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Векторный объект — макет обновляется сразу при правке полей.
                        </MudText>
                    }

                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="@Busy" FullWidth="true"
                               Class="mt-2" StartIcon="@Icons.Material.Filled.Delete"
                               OnClick="@(() => DeleteShapeAsync(Selected.Index))">Удалить объект</MudButton>
                }
            </MudPaper>

            @if (Model.Counters.Count > 0 || Model.Variables.Count > 0)
            {
                <MudPaper Class="pa-2 mt-2" Elevation="1">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Счётчики и переменные</MudText>
                    @foreach (var line in Model.Counters.Concat(Model.Variables))
                    {
                        <MudText Typo="Typo.caption" Style="font-family:monospace;">@line</MudText>
                    }
                </MudPaper>
            }

        </div>
    </div>
    </div>

    <MudExpansionPanels Elevation="1" Class="mt-2">
        <MudExpansionPanel Text="EZPL — что порт шлёт принтеру (отладка П5)">
            @if (Model.EzplOk)
            {
                <pre class="sync-editor-ezpl">@Model.EzplText</pre>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                    <pre class="sync-editor-ezpl">@Model.EzplText</pre>
                </MudAlert>
            }
        </MudExpansionPanel>
    </MudExpansionPanels>
}

@if (Profile is { } printerProfile)
{
    <LegacyPrinterLengthDialog Profile="printerProfile" />
}

@code {
    [Parameter] public int Id { get; set; }

    private TemplateEditorDto? Model { get; set; }

    private IJSObjectReference? _module;
    private DotNetObjectReference<TemplateEditorCallbacks>? _callbacks;

    private int? SelectedIndex { get; set; }

    private bool ShowHidden { get; set; } = true;

    private LengthUnit Unit { get; set; }

    private bool Busy { get; set; }

    /// <summary>Пикселей CSS на мм при масштабе ×1 (экран 96 dpi — определение CSS-пикселя).</summary>
    private const double PxPerMm = 96.0 / 25.4;

    private TemplateEditorShapeDto? Selected =>
        Model?.Shapes.FirstOrDefault(s => s.Index == SelectedIndex);

    private ElementReference _editorRoot;

    protected override async Task OnInitializedAsync()
    {
        Busy = true;
        try
        {
            Model = await EditorService.OpenAsync(Id);
            SetupEdits = ToSetupEdits(Model.Setup);
            await TrackProfileAsync(EditorPrinter.Id);
        }
        catch (Exception ex)
        {
            await Notify.Error(ex.Message);
        }
        finally
        {
            Busy = false;
        }
    }

