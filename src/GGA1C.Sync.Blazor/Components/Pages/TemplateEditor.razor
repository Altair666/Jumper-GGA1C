    // ── Единицы и координаты ──────────────────────────────────────────────────

    private double DotsToUnit(double dots) => Unit == LengthUnit.Dot ? dots
        : LengthUnits.FromMillimetres(dots / Model!.DotsPerMm, Unit, Model.DotsPerMm);

    private float UnitToDots(double value) => Unit == LengthUnit.Dot ? (float)value
        : (float)(LengthUnits.ToMillimetres(value, Unit, Model!.DotsPerMm) * Model.DotsPerMm);

    private string UnitLabel(string field) => $"{field}, {UnitShort(Unit)}";

    // Dot coordinates of existing EZPX files retain the template's scale.
    private double UnitsPerMm => LengthUnits.PerMillimetre(Unit, Model?.DotsPerMm ?? 8);

    // ── Правки выбранного объекта в единицах линейки ─────────────────────────

    private double EditsX { get => Selected == null ? 0 : Math.Round(DotsToUnit(Selected.X), 3); set { if (Selected != null) Selected.X = UnitToDots(value); } }

    private double EditsY { get => Selected == null ? 0 : Math.Round(DotsToUnit(Selected.Y), 3); set { if (Selected != null) Selected.Y = UnitToDots(value); } }

    private double EditsWidth { get => Selected?.Width == null ? 0 : Math.Round(DotsToUnit(Selected.Width.Value), 3); set { if (Selected?.Width != null) Selected.Width = UnitToDots(value); } }

    private double EditsHeight { get => Selected?.Height == null ? 0 : Math.Round(DotsToUnit(Selected.Height.Value), 3); set { if (Selected?.Height != null) Selected.Height = UnitToDots(value); } }

    // ── Отрисовка объектов (SVG, координаты в мм; слой собирается строкой — тег
    //    <text> в Razor зарезервирован) ─────────────────────────────────────────

    private static string FormatNumber(double v) =>
        v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string GeometryNumber(double value) => value.ToString("R", CultureInfo.InvariantCulture);

    private static string Fmt(float mm) => mm.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private (double Width, double Height) BboxMm(TemplateEditorShapeDto shape)
    {
        if (shape.IsRaster)
        {
            return (shape.RasterWidthDots / Model!.DotsPerMm, shape.RasterHeightDots / Model!.DotsPerMm);
        }
        if (shape.Width != null)
        {
            return (shape.Width.Value / Model!.DotsPerMm, shape.Height!.Value / Model!.DotsPerMm);
        }

        // Текст шрифтом принтера: ширины в шаблоне нет, оценка по самой длинной строке
        // (многострочный «Текст» — строки по \n).
        var lines = TextLines(shape.Data);
        double longest = lines.Length == 0 ? 0 : lines.Max(l => l.Length);
        double height = FontSizeMm(shape) * Math.Max(1, lines.Length) * 1.2;
        double width = Math.Max(8, longest * FontSizeMm(shape) * 0.62);
        return (width, height);
    }

    /// <summary>
    /// Размер знака «текста принтера» в мм — как рисует предпросмотр GoLabel
    /// (Text.Draw: FontHeight в пунктах × Dpi/72 точек; в мм — FontHeight × 25.4/72).
    /// </summary>
    private static double FontSizeMm(TemplateEditorShapeDto shape) =>
        Math.Clamp(shape.FontHeightPoints * 25.4 / 72.0, 0.8, 30);

    private static string[] TextLines(string? value) =>
        (value ?? "").Replace("\r\n", "\n").Replace('\r', '\n').Split('\n');

    private static string Esc(string? value) =>
        (value ?? "").Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;")
            .Replace("\r", " ").Replace("\n", " ");

    private string ShapesSvg()
    {
        if (Model == null)
        {
            return "";
        }

        var svg = new StringBuilder();
        double dpm = Model.DotsPerMm;

        // GoLabel печатает с конца списка: первый объект накладывается последним.
        foreach (var shape in Model.Shapes.AsEnumerable().Reverse())
        {
            if (!ShowHidden && !shape.IsPrint)
            {
                continue;
            }

            double x = shape.X / dpm;
            double y = shape.Y / dpm;
            var (w, h) = BboxMm(shape);
            double opacity = shape.IsPrint ? 1 : 0.25;

            // Группа с прозрачным «хитом» на всю площадь: рамки с fill=none сами мышь
            // не ловят, а JS-перетаскиванию (П12.4) нужен цельный клик по объекту.
            var selection = SelectedIndex == shape.Index ? " is-selected" : "";
            svg.Append($"<g data-shape-index=\"{shape.Index}\" data-x=\"{GeometryNumber(x)}\" " +
                       $"data-y=\"{GeometryNumber(y)}\" class=\"sync-shape{selection}\">");
            string hit = $"<rect x=\"{Fmt((float)x)}\" y=\"{Fmt((float)y)}\" width=\"{Fmt((float)w)}\" " +
                         $"height=\"{Fmt((float)h)}\" class=\"sync-shape-hit\" />";

            if (shape.IsRaster && shape.RasterPngBase64 != null)
            {
                svg.Append($"<image href=\"data:image/png;base64,{shape.RasterPngBase64}\" x=\"{Fmt((float)x)}\" " +
                           $"y=\"{Fmt((float)y)}\" width=\"{Fmt((float)w)}\" height=\"{Fmt((float)h)}\" " +
                           $"preserveAspectRatio=\"none\" opacity=\"{opacity:0.##}\"/>");
                svg.Append(hit).Append("</g>");
                continue;
            }

            switch (shape.TypeName)
            {
                case "Text":
                    // Многострочный «Текст» GoLabel: строки по \n, шаг ~1.2 размера знака
                    var textLines = TextLines(shape.Data);
                    var textSvg = new StringBuilder(
                        $"<text x=\"{Fmt((float)x)}\" y=\"{Fmt((float)y)}\" font-family=\"sans-serif\" " +
                        $"font-size=\"{Fmt((float)FontSizeMm(shape))}\" opacity=\"{opacity:0.##}\">");
                    for (int li = 0; li < textLines.Length; li++)
                    {
                        string dy = li == 0
                            ? Fmt((float)(FontSizeMm(shape) * 0.9))
                            : Fmt((float)(FontSizeMm(shape) * 1.2));
                        textSvg.Append($"<tspan x=\"{Fmt((float)x)}\" dy=\"{dy}\">{Esc(textLines[li])}</tspan>");
                    }
                    textSvg.Append("</text>");
                    svg.Append(textSvg);
                    break;

                case "QRectangle":
                    svg.Append($"<rect x=\"{Fmt((float)x)}\" y=\"{Fmt((float)y)}\" width=\"{Fmt((float)w)}\" " +
                               $"height=\"{Fmt((float)h)}\" fill=\"none\" stroke=\"black\" " +
                               $"stroke-width=\"{Fmt(StrokeMm(shape))}\" opacity=\"{opacity:0.##}\"/>");
                    break;

                case "Line":
                    svg.Append($"<rect x=\"{Fmt((float)x)}\" y=\"{Fmt((float)y)}\" width=\"{Fmt((float)w)}\" " +
                               $"height=\"{Fmt((float)h)}\" fill=\"black\" opacity=\"{opacity:0.##}\"/>");
                    break;

                case "BarCode":
                    svg.Append($"<rect x=\"{Fmt((float)x)}\" y=\"{Fmt((float)y)}\" width=\"{Fmt((float)w)}\" " +
                               $"height=\"{Fmt((float)h)}\" fill=\"white\" stroke=\"black\" stroke-width=\"0.2\" " +
                               $"opacity=\"{opacity:0.##}\"/>");
                    svg.Append($"<text x=\"{Fmt((float)(x + 1))}\" y=\"{Fmt((float)(y + 2.5))}\" font-family=\"monospace\" " +
                               $"font-size=\"2\" opacity=\"{opacity:0.##}\">{Esc(shape.Data)}</text>");
                    break;

                default:
                    svg.Append($"<rect x=\"{Fmt((float)x)}\" y=\"{Fmt((float)y)}\" width=\"{Fmt((float)w)}\" " +
                               $"height=\"{Fmt((float)h)}\" fill=\"none\" stroke=\"red\" stroke-width=\"0.25\" " +
                               $"stroke-dasharray=\"1,1\" opacity=\"{opacity:0.##}\"/>");
                    svg.Append($"<text x=\"{Fmt((float)(x + 1))}\" y=\"{Fmt((float)(y + 2.5))}\" font-size=\"2\" " +
                               $"fill=\"red\" opacity=\"{opacity:0.##}\">{Esc(shape.TypeName)}</text>");
                    break;
            }

            svg.Append(hit).Append("</g>");
        }

        return svg.ToString();
    }

    private float StrokeMm(TemplateEditorShapeDto shape) =>
        shape.Height == null ? 0.13f : Math.Clamp(shape.Height.Value, 1, 8) / Model!.DotsPerMm;

    // ── Действия ──────────────────────────────────────────────────────────────

    private static string ShortData(TemplateEditorShapeDto shape)
    {
        var text = shape.Data ?? "";
        return text.Length <= 32 ? text : text[..32] + "…";
    }

    private async Task RebuildRasterAsync()
    {
        if (Model == null || Selected == null)
        {
            return;
        }

        Busy = true;
        try
        {
            var preview = await EditorService.RenderPreviewAsync(new TemplateEditorChangesDto
            {
                TemplateId = Model.TemplateId,
                Changes = [new TemplateEditorShapeChangeDto { Index = Selected.Index, Data = Selected.Data }],
            });

            if (preview.Rasters.TryGetValue(Selected.Index, out var raster))
            {
                Selected.RasterPngBase64 = raster;
                await Notify.Success("Картинка объекта пересобрана.");
            }
        }
        catch (Exception ex)
        {
            await Notify.Error(ex.Message);
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task SaveAsync()
    {
        if (Model == null)
        {
            return;
        }
        if (!await Message.Confirm("Сохранить правки? В хабе появится новая версия файла шаблона."))
        {
            return;
        }

        Busy = true;
        try
        {
            Model = await EditorService.SaveAsync(new TemplateEditorChangesDto
            {
                TemplateId = Model.TemplateId,
                Changes = CurrentShapes(),
                Setup = SetupChanges(),
            });
            SetupEdits = ToSetupEdits(Model.Setup);
            await Notify.Success("Правки сохранены новой версией файла.");
        }
        catch (Exception ex)
        {
            await Notify.Error(ex.Message);
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task DownloadAsync()
    {
        if (Model == null || _module == null)
        {
            return;
        }
        Busy = true;
        try
        {
            var file = await EditorService.DownloadAsync(Model.TemplateId);
            await _module.InvokeVoidAsync(
                "downloadFile", file.FileName, Convert.ToBase64String(file.Content));
        }
        catch (Exception ex)
        {
            await Notify.Error(ex.Message);
        }
        finally
        {
            Busy = false;
        }
    }

    /// <summary>
    /// Отсылаем все объекты с их текущими значениями: правки применяются присваиванием,
    /// неизменённые значения — no-op. Проще и надёжнее отслеживания «что трогали».
    /// </summary>
    private List<TemplateEditorShapeChangeDto> CurrentShapes() =>
        Model!.Shapes.Select(s => new TemplateEditorShapeChangeDto
        {
            Index = s.Index,
            X = s.X,
            Y = s.Y,
            Width = s.Width,
            Height = s.Height,
            Data = s.Data,
        }).ToList();

    private TemplateSetupChangeDto SetupChanges() => new()
    {
        WidthMm = Model!.Setup.WidthMm,
        HeightMm = Model.Setup.HeightMm,
        GapMm = Model.Setup.GapMm,
        LeftMarginDots = Model.Setup.LeftMarginDots,
        RightMarginDots = Model.Setup.RightMarginDots,
        TopMarginDots = Model.Setup.TopMarginDots,
        BottomMarginDots = Model.Setup.BottomMarginDots,
        LabelMode = Model.Setup.LabelMode,
        HorAcross = Model.Setup.HorAcross,
        VerAcross = Model.Setup.VerAcross,
        HorGapMm = Model.Setup.HorGapMm,
        VerGapMm = Model.Setup.VerGapMm,
        AcrossType = Model.Setup.AcrossType,
        Shape = Model.Setup.Shape,
        LabelType = Model.Setup.LabelType,
        FeedMm = Model.Setup.FeedMm,
        BlackMarkMm = Model.Setup.BlackMarkMm,
        BlackMarkPositionMm = Model.Setup.BlackMarkPositionMm,
        BlackMarkAfter = Model.Setup.BlackMarkAfter,
        Speed = Model.Setup.Speed,
        Darkness = Model.Setup.Darkness,
        Copies = Model.Setup.Copies,
        DirectThermal = Model.Setup.DirectThermal,
    };

    private static TemplateSetupChangeDto ToSetupEdits(TemplateSetupDto s) => new()
    {
        WidthMm = s.WidthMm,
        HeightMm = s.HeightMm,
        GapMm = s.GapMm,
        LeftMarginDots = s.LeftMarginDots,
        RightMarginDots = s.RightMarginDots,
        TopMarginDots = s.TopMarginDots,
        BottomMarginDots = s.BottomMarginDots,
        LabelMode = s.LabelMode,
        HorAcross = s.HorAcross,
        VerAcross = s.VerAcross,
        HorGapMm = s.HorGapMm,
        VerGapMm = s.VerGapMm,
        AcrossType = s.AcrossType,
        Shape = s.Shape,
        LabelType = s.LabelType,
        FeedMm = s.FeedMm,
        BlackMarkMm = s.BlackMarkMm,
        BlackMarkPositionMm = s.BlackMarkPositionMm,
        BlackMarkAfter = s.BlackMarkAfter,
        Speed = s.Speed,
        Darkness = s.Darkness,
        Copies = s.Copies,
