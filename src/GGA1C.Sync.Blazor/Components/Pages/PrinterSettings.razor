@page "/labels/printer-settings"
@attribute [Authorize(GGA1C.Sync.Permissions.SyncPermissions.Admin)]
@using System.Collections.Generic
@using GGA1C.Sync.Printing
@using GGA1C.Sync.Printing.Profiles
@inherits PrinterProfileComponent
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime

<MudText Typo="Typo.h5" Class="mb-4">Настройка печати</MudText>
<MudCard Style="max-width: 36rem;">
    <MudCardContent>
        <MudStack Spacing="3">
            <MudSelect T="string" Label="Принтер" Value="@_printerId" ValueChanged="SelectPrinterAsync"
                       Variant="Variant.Outlined" Disabled="@_busy">
                @foreach (var printer in PrinterCatalog.Printers)
                {
                    <MudSelectItem T="string" Value="@printer.Id">@printer.Caption</MudSelectItem>
                }
            </MudSelect>
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
            }
            @if (Profile is { } profile)
            {
                var definition = profile.Definition;
                if (definition.Fields.Count == 0)
                {
                    <MudText>Настройки пока не реализованы</MudText>
                }
                else
                {
                    if (definition.Fields.Any(field => field.Kind == PrinterFieldKind.Length))
                    {
                        <MudButton Class="align-self-start" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                   OnClick="CycleUnit" aria-label="@($"Единицы измерения: {LengthUnits.Symbol(_unit)}")">
                            @LengthUnits.Symbol(_unit)
                        </MudButton>
                    }
                    @foreach (var field in definition.Fields)
                    {
                        var id = $"printer-{field.Id}";
                        var value = profile.Value(field.Id);
                        var draft = _draft.GetValueOrDefault(field.Id, value);
                        <div @key="field.Id">
                            @if (field.ReadOnly)
                            {
                                var display = field.Kind == PrinterFieldKind.Length
                                    ? LengthUnits.FromMillimetres(value, _unit, definition.DotsPerMm) : value;
                                var unit = field.Kind == PrinterFieldKind.Length ? LengthUnits.Symbol(_unit) : field.Unit;
                                <MudTextField T="string" Label="@field.Caption" ReadOnly="true" Variant="Variant.Outlined"
                                              Value="@($"{PageSetupMeasurement.Format(display)} {unit}")" />
                            }
                            else if (field.Kind == PrinterFieldKind.Length)
                            {
                                <PrinterLengthInput Id="@id" Field="field" Unit="_unit" DotsPerMm="definition.DotsPerMm"
                                                    Millimetres="draft" SavedMillimetres="value" Disabled="@FieldsDisabled"
                                                    UpdateWhileTyping="true" MillimetresChanged="@(next => Edit(field.Id, value, next))" />
                            }
                            else
                            {
                                <PageSetupMeasurement Id="@id" Caption="@field.Caption" Unit="@field.Unit" Hint="@field.Hint"
                                                      Value="draft" Disabled="@FieldsDisabled"
                                                      ValueChanged="@(next => Edit(field.Id, value, next))" />
                            }
                            @if (field.Hint is not null)
                            {
                                <MudText Typo="Typo.caption" Class="mt-1 mud-text-secondary">@field.Hint</MudText>
                            }
                        </div>
                    }
                    @if (definition.Fields.Any(field => !field.ReadOnly))
                    {
                        <MudButton Class="align-self-start" Variant="Variant.Filled" Color="Color.Primary"
                                   Disabled="@(FieldsDisabled || _draft.Count == 0)" OnClick="SaveAsync">Сохранить</MudButton>
                    }
                }
            }
        </MudStack>
    </MudCardContent>
</MudCard>

@if (Profile is { Definition.Id: PrinterCatalog.Zx430i } zx430i)
{
    <LegacyPrinterLengthDialog Profile="zx430i" />
}

@code {
    private string _printerId = PrinterCatalog.Zx430i;
    private LengthUnit _unit;
    private bool _busy;
    private string? _error;
    private readonly Dictionary<string, double> _draft = new();
    private IJSObjectReference? _inputModule;
    private bool FieldsDisabled => _busy || Profile?.LegacyChoices.Count > 0;

    protected override Task OnInitializedAsync() => SelectPrinterAsync(_printerId);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _inputModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/page-setup.js");
    }

    private async Task SelectPrinterAsync(string printerId)
    {
        _printerId = printerId;
        _draft.Clear();
        _busy = true;
        _error = null;
        try { await TrackProfileAsync(printerId); }
        catch (Exception ex) { _error = $"Не удалось загрузить настройки. {ex.Message}"; }
        finally { _busy = false; }
    }

    private void CycleUnit() => _unit = LengthUnits.Next(_unit);

    private void Edit(string fieldId, double saved, double value)
    {
        if (saved == value) _draft.Remove(fieldId);
        else _draft[fieldId] = value;
    }

    protected override void ProfileReceived(PrinterProfile? previous, PrinterProfile profile)
    {
        if (previous == null) return;
        foreach (var field in profile.Definition.Fields)
            if (previous.Value(field.Id) != profile.Value(field.Id)) _draft.Remove(field.Id);
    }

    private async Task SaveAsync()
    {
        if (FieldsDisabled || Profile is not { } profile || _draft.Count == 0) return;
        _busy = true;
        _error = null;
        try
        {
            ReceiveProfile(await Profiles.SaveAsync(profile.Definition.Id, profile.Revision, new Dictionary<string, double>(_draft)));
            _draft.Clear();
        }
        catch (Exception ex) { _error = $"Не удалось сохранить настройки. {ex.Message}"; }
        finally { _busy = false; }
    }

    public async ValueTask DisposeAsync()
    {
        StopTrackingProfiles();
        if (_inputModule == null) return;
        try { await _inputModule.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
