@page "/labels"
@attribute [Authorize(GGA1C.Sync.Permissions.SyncPermissions.Admin)]
@using GGA1C.Sync.Labels
@inherits SyncComponentBase

<MudText Typo="Typo.h5" Class="mb-4">Grist → GoLabel2</MudText>

@if (!string.IsNullOrEmpty(ShownKey))
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Class="mb-4"
              ShowCloseIcon="true" CloseIconClicked="@(() => ShownKey = null)">
        <MudText Typo="Typo.body1"><b>@ShownKeyFor</b></MudText>
        <MudTextField Value="@ShownKey" ReadOnly="true" T="string" Class="mt-1"
                      Variant="Variant.Filled" Margin="Margin.Dense"
                      Style="font-family: monospace;" />
        <MudText Typo="Typo.caption">
            Выделить и скопировать, затем вставить в настройках виджета (⚙) в поле API Key.
            Кнопки копирования нет намеренно: браузерный буфер обмена работает только
            на https, а сервис — по http, и кнопка молча не срабатывала бы.
        </MudText>
    </MudAlert>
}

@if (Creds != null)
{
    <MudCard Class="mb-4">
        <MudCardContent>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-1">
                <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Color="Color.Primary" />
                <MudText Typo="Typo.h6">Учётные данные: @Creds.Name</MudText>
            </MudStack>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                Чем хаб представляется во внешних системах от имени этого человека. Пароли
                хранятся зашифрованными: в поле приходит столько точек, сколько в пароле
                знаков. Оставить точки — не менять, стереть — удалить пароль.
            </MudText>

            <MudText Typo="Typo.subtitle2" Class="mb-2">Altium Designer</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="Creds.AltiumLogin" Label="Логин" T="string"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Adornment="@Mark(Filled(Creds.AltiumLogin))"
                                  AdornmentIcon="@Icons.Material.Filled.CheckCircle"
                                  AdornmentColor="Color.Success" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="Creds.AltiumPassword" Label="Пароль" T="string"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Adornment="@Mark(Creds.HasAltiumPassword)"
                                  AdornmentIcon="@Icons.Material.Filled.CheckCircle"
                                  AdornmentColor="Color.Success" />
                </MudItem>
            </MudGrid>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1 mb-4">
                Учётка в Altium Enterprise Server: выгрузка компонентов идёт от имени человека,
                чтобы в журнале Altium оставался он, а не одна служебная учётка на весь завод.
            </MudText>

            <MudText Typo="Typo.subtitle2" Class="mb-2">SOLIDWORKS PDM</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="Creds.PdmLogin" Label="Логин" T="string"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Adornment="@Mark(Filled(Creds.PdmLogin))"
                                  AdornmentIcon="@Icons.Material.Filled.CheckCircle"
                                  AdornmentColor="Color.Success" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="Creds.PdmPassword" Label="Пароль" T="string"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Adornment="@Mark(Creds.HasPdmPassword)"
                                  AdornmentIcon="@Icons.Material.Filled.CheckCircle"
                                  AdornmentColor="Color.Success" />
                </MudItem>
            </MudGrid>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1 mb-4">
                Логин в хранилище PDM. Пароль приходится хранить потому, что PDM не умеет ни
                SAML, ни OIDC — через Keycloak в него не войти, а действовать от имени
                человека без его пароля он не позволяет.
            </MudText>

            <MudText Typo="Typo.subtitle2" Class="mb-2">База печати (GoLabel II)</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudTextField Value="@Creds.PrintLogin" Label="Логин" T="string"
                                  Disabled="true"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudTextField @bind-Value="Creds.PrintPassword" Label="Пароль" T="string"
                                      Class="flex-grow-1"
                                      InputType="@(PrintPasswordShown ? InputType.Text : InputType.Password)"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Adornment="@Mark(Creds.HasPrintPassword)"
                                      AdornmentIcon="@Icons.Material.Filled.CheckCircle"
                                      AdornmentColor="Color.Success" />
                        <MudIconButton Icon="@(PrintPasswordShown
                                               ? Icons.Material.Filled.VisibilityOff
                                               : Icons.Material.Filled.Visibility)"
                                       Title="Показать пароль" Disabled="@Busy"
                                       OnClick="TogglePrintPasswordAsync" />
                        <MudIconButton Icon="@Icons.Material.Filled.Autorenew" Color="Color.Warning"
                                       Title="Сгенерировать новый пароль" Disabled="@Busy"
                                       OnClick="GeneratePrintPassword" />
                    </MudStack>
                </MudItem>
            </MudGrid>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1 mb-4">
                Логин меняться не может: это почта человека из Keycloak, а у заведённых вручную —
                имя их учётной записи. Учётка в MySQL создаётся сама с паролем
                <code>1234</code>; пароль можно посмотреть глазом, сгенерировать новый
                стрелками и применить сохранением.
            </MudText>

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium"
                           Disabled="@Busy" StartIcon="@Icons.Material.Filled.Save"
                           Style="@ButtonWidth" OnClick="SaveCredsAsync">Сохранить</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Medium"
                           Disabled="@Busy" StartIcon="@Icons.Material.Filled.Close"
                           Style="@ButtonWidth" OnClick="@(() => Creds = null)">Закрыть</MudButton>
                <MudSpacer />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Изменены: @FormatWhen(Creds.UpdatedAt)
                </MudText>
            </MudStack>
        </MudCardContent>
    </MudCard>
}

<MudCard Class="mb-4">
    <MudCardContent>
        <MudText Typo="Typo.h6" Class="mb-1">Добавить учётную запись вручную</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            Нужно только тем, кого нет в Keycloak. Папка буфера подбирается сама —
            из фамилии, а если из неё ничего не выходит, из email.
        </MudText>

        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="NewName" Label="Имя" T="string"
                              Placeholder="Иванов Пётр"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="NewEmail" Label="Email" T="string"
                              Placeholder="p.ivanov@mp-lab.ru"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              HelperText="Нужен, чтобы ключ попадал в виджет сам" />
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Spacing="2" Class="mt-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium"
                       Disabled="@Busy" StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="CreateAsync">Создать и выдать ключ</MudButton>
        </MudStack>
    </MudCardContent>
</MudCard>

<MudCard Class="mb-4">
    <MudCardContent>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
            <MudText Typo="Typo.h6">Учётные записи</MudText>
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
                @Clients.Count
            </MudChip>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Medium"
                       Disabled="@Busy" StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadAsync">Обновить</MudButton>
        </MudStack>

        @if (Clients.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                Учётных записей нет. Заведите вручную или подтяните из Keycloak.
            </MudAlert>
        }
        else
        {
            <MudTable Items="@Clients" Dense="true" Hover="true" T="LabelClientDto">
                <HeaderContent>
                    <MudTh>Имя</MudTh>
                    <MudTh>Папка</MudTh>
                    <MudTh>Ключ</MudTh>
                    <MudTh>Этикеток</MudTh>
                    <MudTh>Логин печати</MudTh>
                    <MudTh>Данные</MudTh>
                    <MudTh>Использован</MudTh>
                    <MudTh>Включена</MudTh>
                    <MudTh Style="width: 200px;">Действия</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Имя">@context.Name</MudTd>
                    <MudTd DataLabel="Папка"><code>@context.Slug</code></MudTd>
                    <MudTd DataLabel="Ключ"><code>@context.KeyPrefix…</code></MudTd>
                    <MudTd DataLabel="Этикеток">@context.RowCount</MudTd>
                    <MudTd DataLabel="Логин печати">
                        @if (string.IsNullOrEmpty(context.PrintLogin))
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">не выдан</MudText>
                        }
                        else
                        {
                            <code>@context.PrintLogin</code>
                        }
                    </MudTd>
                    <MudTd DataLabel="Данные">
                        <MudStack Row="true" Spacing="1">
                            <MudIcon Size="Size.Small" Title="Altium Designer"
                                     Icon="@Icons.Material.Filled.Memory"
                                     Color="@StateColor(context.HasAltiumCredentials)" />
                            <MudIcon Size="Size.Small" Title="SOLIDWORKS PDM"
                                     Icon="@Icons.Material.Filled.Inventory2"
                                     Color="@StateColor(context.HasPdmCredentials)" />
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="Использован">
                        <MudText Typo="Typo.caption">@FormatWhen(context.LastUsedAt)</MudText>
                    </MudTd>
                    <MudTd DataLabel="Включена">
                        <MudSwitch T="bool" Color="Color.Primary" Value="@context.IsEnabled"
                                   ValueChanged="@(v => ToggleAsync(context, v))" />
                    </MudTd>
                    <MudTd>
                        <MudStack Row="true" Spacing="0">
                            <MudIconButton Icon="@Icons.Material.Filled.ManageAccounts" Size="Size.Small"
                                           Color="Color.Primary" Title="Учётные данные Altium и PDM"
                                           Disabled="@Busy"
                                           OnClick="@(() => OpenCredsAsync(context))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                           Title="Показать ключ" Disabled="@Busy"
                                           OnClick="@(() => RevealAsync(context))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Autorenew" Size="Size.Small"
                                           Color="Color.Warning" Title="Перевыпустить ключ" Disabled="@Busy"
                                           OnClick="@(() => RegenerateAsync(context))" />
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep" Size="Size.Small"
                                           Title="Очистить буфер" Disabled="@Busy"
                                           OnClick="@(() => ClearBufferAsync(context))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                           Color="Color.Error" Title="Удалить учётку" Disabled="@Busy"
                                           OnClick="@(() => DeleteAsync(context))" />
                        </MudStack>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }

        <MudDivider Class="my-4" />

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
            <b>GoLabel II:</b> «Подключить базу» → MySQL. Сервер — адрес этого компьютера,
            порт 3306, база <code>gga1c</code>, логин и пароль — выданные здесь, таблица —
            <code>my_labels</code>. Ни ODBC, ни источников данных: в GoLabel II своего
            драйвера MySQL достаточно, а ODBC он не поддерживает вовсе.
        </MudAlert>

        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            В настройках виджета: <b>Server URL</b> — адрес этого сервера (тот же, с которого
            открыт сам виджет, иначе браузер заблокирует запрос), <b>API Key</b> — ключ учётки,
            <b>Endpoint</b> — <code>/api/grist/labels/replace-all</code>. Ключ принимается и
            как <code>Authorization: Bearer</code>, и как <code>X-Api-Key</code>.
        </MudText>
    </MudCardContent>
</MudCard>

<MudCard>
    <MudCardContent>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
            <MudText Typo="Typo.h6">Буферы</MudText>
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
                @Buffers.Count
            </MudChip>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Medium"
                       Disabled="@Busy" StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadBuffersAsync">Обновить</MudButton>
        </MudStack>

        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            Это то, что сейчас лежит в базе и что забирает GoLabel II. У каждого человека
            свой логин в MySQL, и представление <code>my_labels</code> отдаёт ему только его
            строки — чужие он не увидит, прав на саму таблицу у него нет. Ни драйверов, ни
            источников данных на машине с принтером настраивать не нужно.
        </MudText>

        @if (Buffers.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                Буферы пусты: строки появятся после синхронизации из виджета.
            </MudAlert>
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true" Elevation="0" Outlined="true">
                @foreach (var buffer in Buffers)
                {
                    <MudExpansionPanel>
                        <TitleContent>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@(buffer.ClientId == null
                                                 ? Icons.Material.Filled.PersonOff
                                                 : Icons.Material.Filled.Print)"
                                         Color="@(buffer.ClientId == null ? Color.Warning : Color.Default)" />
                                <MudText Typo="Typo.body1"><b>@buffer.Name</b></MudText>
                                <code>@buffer.Slug</code>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                         Color="@(buffer.RowCount > 0 ? Color.Success : Color.Default)">
                                    @buffer.RowCount @Plural(buffer.RowCount)
                                </MudChip>
                                @if (buffer.ClientId == null)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                             Variant="Variant.Outlined">нет учётки</MudChip>
                                }
                                @if (buffer.ClientId != null && string.IsNullOrEmpty(buffer.PrintLogin))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                             Variant="Variant.Outlined">логин печати не выдан</MudChip>
                                }
                                <MudSpacer />
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @FormatWhen(buffer.UpdatedAt)
                                </MudText>
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            @if (!string.IsNullOrEmpty(buffer.PrintLogin))
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2"
                                         Style="font-family: monospace;">
                                    @buffer.PrintLogin → my_labels
                                </MudText>
                            }

                            @if (buffer.Rows.Count == 0)
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                    Буфер пуст — синхронизация из виджета его наполнит.
                                </MudAlert>
                            }
                            else
                            {
                                <MudTable Items="@buffer.Rows" Dense="true" Hover="true"
                                          Striped="true" T="LabelRecord" Elevation="0">
                                    <HeaderContent>
                                        <MudTh>Дата</MudTh>
                                        <MudTh>Код изделия</MudTh>
                                        <MudTh>Код режима</MudTh>
                                        <MudTh>Ключ строки</MudTh>
                                        <MudTh>Обновлена</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Дата">@context.Date</MudTd>
                                        <MudTd DataLabel="Код изделия"><code>@context.ProductCode</code></MudTd>
                                        <MudTd DataLabel="Код режима"><code>@context.ModeCode</code></MudTd>
                                        <MudTd DataLabel="Ключ строки">
                                            <MudText Typo="Typo.caption">@context.ExternalId</MudText>
                                        </MudTd>
                                        <MudTd DataLabel="Обновлена">
                                            <MudText Typo="Typo.caption">@FormatWhen(context.UpdatedAt)</MudText>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>

                                @if (buffer.RowCount > buffer.Rows.Count)
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">
                                        Показаны первые @buffer.Rows.Count из @buffer.RowCount —
                                        остальное читается из файла.
                                    </MudText>
                                }
                            }

                            @if (buffer.ClientId == null)
                            {
                                <MudStack Row="true" Spacing="2" Class="mt-3">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error"
                                               Size="Size.Medium" Disabled="@Busy"
                                               StartIcon="@Icons.Material.Filled.Delete"
                                               OnClick="@(() => DeleteFolderAsync(buffer))">
                                        Удалить строки
                                    </MudButton>
                                </MudStack>
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    </MudCardContent>
</MudCard>
