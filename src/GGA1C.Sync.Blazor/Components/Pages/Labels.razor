@page "/labels"
@attribute [Authorize]
@using GGA1C.Sync.Labels
@using GGA1C.Sync.Keycloak
@using GGA1C.Sync.Connections
@inherits SyncComponentBase

<MudText Typo="Typo.h5" Class="mb-4">Grist → GoLabel2</MudText>

@if (!string.IsNullOrEmpty(ShownKey))
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Class="mb-4"
              ShowCloseIcon="true" CloseIconClicked="@(() => ShownKey = null)">
        <MudText Typo="Typo.body1"><b>@ShownKeyFor</b></MudText>
        <MudTextField Value="@ShownKey" ReadOnly="true" T="string" Class="mt-1"
                      Variant="Variant.Filled" Margin="Margin.Dense"
                      Style="font-family: monospace;" />
        <MudText Typo="Typo.caption">
            Выделить и скопировать, затем вставить в настройках виджета (⚙) в поле API Key.
            Кнопки копирования нет намеренно: браузерный буфер обмена доступен только
            на https, а сервис работает по http — кнопка молча не срабатывала бы.
        </MudText>
    </MudAlert>
}

<MudCard Class="mb-4">
    <MudCardContent>
        <MudText Typo="Typo.h6" Class="mb-3">Учётные записи из Keycloak</MudText>

        <MudGrid Spacing="2">
            <MudItem xs="12" md="5">
                <MudTextField @bind-Value="Kc.BaseUrl" Label="Адрес Keycloak" T="string"
                              Placeholder="http://192.168.88.238:8080"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              HelperText="Без /realms" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="Kc.Realm" Label="Реалм" T="string"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="Kc.ClientId" Label="Клиент" T="string"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="Kc.ClientSecret" Label="Секрет клиента" T="string"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              HelperText="@(Kc.HasClientSecret ? "Сохранён. Пустое поле — оставить как есть" : "Не задан")" />
            </MudItem>
            <MudItem xs="12" md="6" Class="d-flex align-center gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@Busy"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="SaveKeycloakAsync">Сохранить</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Info" Disabled="@Busy"
                           StartIcon="@Icons.Material.Filled.NetworkCheck"
                           OnClick="TestKeycloakAsync">Проверить связь</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Success" Disabled="@Busy"
                           StartIcon="@Icons.Material.Filled.Sync"
                           OnClick="SyncKeycloakAsync">Синхронизировать</MudButton>
            </MudItem>
        </MudGrid>

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3">
            Клиенту в Keycloak нужна включённая служебная учётная запись и роль
            <code>view-users</code> из <code>realm-management</code> — без неё токен выдаётся,
            а список пользователей отвечает 403. Чужие пароли при этом не нужны и не хранятся.
        </MudAlert>

        @if (KcTest != null)
        {
            <MudAlert Class="mt-3" Severity="@(KcTest.Ok ? Severity.Success : Severity.Error)"
                      Variant="Variant.Outlined">@KcTest.Message</MudAlert>
        }

        @if (KcReport != null)
        {
            <MudAlert Class="mt-3" Severity="@(KcReport.Ok ? Severity.Success : Severity.Error)"
                      Variant="Variant.Outlined">
                @if (!KcReport.Ok)
                {
                    <MudText Typo="Typo.body2">@KcReport.Message</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2">
                        Проверено: @KcReport.Checked · создано: @KcReport.Created ·
                        обновлено: @KcReport.Updated · привязано: @KcReport.Linked ·
                        отключено: @KcReport.Disabled · включено: @KcReport.Restored
                        @if (KcReport.SkippedWithoutEmail > 0)
                        {
                            <text> · без email: @KcReport.SkippedWithoutEmail</text>
                        }
                    </MudText>
                    @foreach (var line in KcReport.Details)
                    {
                        <MudText Typo="Typo.caption" Class="d-block">@line</MudText>
                    }
                }
            </MudAlert>
        }
    </MudCardContent>
</MudCard>

<MudCard Class="mb-4">
    <MudCardContent>
        <MudText Typo="Typo.h6" Class="mb-3">Новая учётная запись</MudText>
        <MudGrid Spacing="2" Class="align-center">
            <MudItem xs="12" md="5">
                <MudTextField Value="@NewName" ValueChanged="@OnNameChanged" T="string"
                              Label="Имя" Immediate="true"
                              Placeholder="Иванов Пётр"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField Value="@NewSlug" ValueChanged="@OnSlugChanged" T="string"
                              Label="Папка буфера" Immediate="true"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              HelperText="@SlugHint" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@Busy"
                           StartIcon="@Icons.Material.Filled.PersonAdd"
                           OnClick="CreateAsync">Создать и выдать ключ</MudButton>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

<MudCard>
    <MudCardContent>
        <MudGrid Spacing="2" Class="align-center mb-3">
            <MudItem><MudText Typo="Typo.h6">Учётные записи</MudText></MudItem>
            <MudSpacer />
            <MudItem>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@Busy"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadAsync">Обновить</MudButton>
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            У каждой учётки свой ключ и свой файл буфера, поэтому синхронизация одного
            оператора не затирает партию другого. Путь к файлу прописывается в источнике
            ODBC на машине с GoLabel2.
        </MudText>

        @if (Clients.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                Учётных записей нет.
            </MudAlert>
        }
        else
        {
            <MudTable Items="@Clients" Dense="true" Hover="true" T="LabelClientDto">
                <HeaderContent>
                    <MudTh>Имя</MudTh>
                    <MudTh>Папка</MudTh>
                    <MudTh>Ключ</MudTh>
                    <MudTh>Этикеток</MudTh>
                    <MudTh>Файл буфера</MudTh>
                    <MudTh>Использован</MudTh>
                    <MudTh>Включена</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Имя">@context.Name</MudTd>
                    <MudTd DataLabel="Папка"><code>@context.Slug</code></MudTd>
                    <MudTd DataLabel="Ключ"><code>@context.KeyPrefix…</code></MudTd>
                    <MudTd DataLabel="Этикеток">@context.RowCount</MudTd>
                    <MudTd DataLabel="Файл буфера">
                        <MudText Typo="Typo.caption">@context.BufferPath</MudText>
                    </MudTd>
                    <MudTd DataLabel="Использован">
                        <MudText Typo="Typo.caption">
                            @(context.LastUsedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Включена">
                        <MudSwitch T="bool" Color="Color.Primary" Value="@context.IsEnabled"
                                   ValueChanged="@(v => ToggleAsync(context, v))" />
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                       Title="Показать ключ" Disabled="@Busy"
                                       OnClick="@(() => RevealAsync(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Autorenew" Size="Size.Small"
                                       Color="Color.Warning" Title="Перевыпустить ключ" Disabled="@Busy"
                                       OnClick="@(() => RegenerateAsync(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep" Size="Size.Small"
                                       Title="Очистить буфер" Disabled="@Busy"
                                       OnClick="@(() => ClearBufferAsync(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       Color="Color.Error" Title="Удалить учётку" Disabled="@Busy"
                                       OnClick="@(() => DeleteAsync(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            В настройках виджета: <b>Server URL</b> — адрес этого сервера (тот же, с которого
            открыт сам виджет, иначе браузер заблокирует запрос), <b>API Key</b> — ключ учётки,
            <b>Endpoint</b> — <code>/api/grist/labels/replace-all</code>. Ключ принимается и
            как <code>Authorization: Bearer</code>, и как <code>X-Api-Key</code>.
        </MudText>
    </MudCardContent>
</MudCard>