@* Раскладка страниц входа: подменяет /Themes/LeptonXLite/Layouts/Account.cshtml из
   Volo.Abp.AspNetCore.Mvc.UI.Theme.LeptonXLite 5.4.0 (восстановлена декомпиляцией, исходника в
   пакете нет). Отличия от штатной - только два:
   1. Бренд «значок + имя» в одну строку: значок слева, имя справа, блок по центру (класс
      sync-login-brand, стили - wwwroot/global-styles.css). Имя - BrandingProvider.AppName,
      то есть настройка Sync.Ui.ServerName.
   2. Страница может забрать верхнюю карточку (смена языка, сообщения, арендатор) к себе:
      ViewData["Sync.HeaderInCard"] = true. Так делает Login.cshtml - у неё одна карточка.
   При обновлении LeptonX Lite сверить с оригиналом. *@
@using System.Globalization
@using System.Net
@using Microsoft.AspNetCore.Http.Extensions
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@using Volo.Abp.AspNetCore.Mvc.UI.Alerts
@using Volo.Abp.AspNetCore.Mvc.UI.Components.LayoutHook
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@using Volo.Abp.AspNetCore.Mvc.UI.MultiTenancy.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Theme.LeptonXLite
@using Volo.Abp.AspNetCore.Mvc.UI.Theme.LeptonXLite.Languages
@using Volo.Abp.AspNetCore.Mvc.UI.Theme.LeptonXLite.Themes.LeptonXLite.Components.PageAlerts
@using Volo.Abp.AspNetCore.Mvc.UI.Theming
@using Volo.Abp.AspNetCore.Mvc.UI.Widgets.Components.WidgetScripts
@using Volo.Abp.AspNetCore.Mvc.UI.Widgets.Components.WidgetStyles
@using Volo.Abp.Localization
@using Volo.Abp.MultiTenancy
@using Volo.Abp.Ui.Branding
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Volo.Abp.AspNetCore.Mvc.UI
@addTagHelper *, Volo.Abp.AspNetCore.Mvc.UI.Bootstrap
@addTagHelper *, Volo.Abp.AspNetCore.Mvc.UI.Bundling
@inject IAlertManager AlertManager
@inject IOptions<AbpThemingOptions> ThemingOptions
@inject ThemeLanguageInfoProvider ThemeLanguageInfoProvider
@inject ICurrentTenant CurrentTenant
@inject IOptions<AbpMultiTenancyOptions> MultiTenancyOptions
@inject ITenantResolveResultAccessor TenantResolveResultAccessor
@inject IStringLocalizer<AbpUiMultiTenancyResource> MultiTenancyStringLocalizer
@inject IPageLayout PageLayout
@inject IBrandingProvider BrandingProvider
@{
    Layout = null;
    var appName = BrandingProvider.AppName;
    string pageTitle = ViewBag.Title == null ? appName : ViewBag.Title;
    var logoUrl = BrandingProvider.LogoUrl == null
        ? null
        : "--lpx-logo: url(" + (BrandingProvider.IsExternalLogoUrl()
            ? BrandingProvider.LogoUrl
            : Url.Content(BrandingProvider.LogoUrl.EnsureStartsWith('/').EnsureStartsWith('~'))) + ");";
    var languageInfo = await ThemeLanguageInfoProvider.GetLanguageSwitchViewComponentModelAsync();
    if (PageLayout.Content.Title != null)
    {
        if (!string.IsNullOrWhiteSpace(pageTitle))
        {
            pageTitle = " | " + pageTitle;
        }
        pageTitle = PageLayout.Content.Title + pageTitle;
    }
    var rtl = CultureHelper.IsRtl ? "rtl" : string.Empty;
}

<!DOCTYPE html>

<html lang="@CultureInfo.CurrentCulture.Name" dir="@rtl">

<head>
	@await Component.InvokeLayoutHookAsync("Header.First", "Account")

	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	<meta http-equiv="X-UA-Compatible" content="ie=edge">
	@if (!ThemingOptions.Value.BaseUrl.IsNullOrWhiteSpace())
	{
		<base href="@ThemingOptions.Value.BaseUrl" />
	}

	<title>@pageTitle</title>

	<link rel="icon" href="~/favicon.svg" type="image/svg+xml">

	<abp-style-bundle name="LeptonXLite.Global" />

	@await Component.InvokeAsync(typeof(WidgetStylesViewComponent))

	@await RenderSectionAsync("styles", required: false)

	@await Component.InvokeLayoutHookAsync("Header.Last", "Account")

	@if (logoUrl != null)
	{
		<style>
			:root .abp-account-layout .lpx-brand-logo {
				@logoUrl
			}
		</style>
	}
</head>

<body class="abp-account-layout @rtl">
	@await Component.InvokeLayoutHookAsync("Body.First", "Account")

	<div class="lpx-scroll-container">
		<div id="lpx-wrapper">

			<div class="lpx-content-container m-0">

				<div class="lpx-content">
					@await Component.InvokeLayoutHookAsync("PageContent.First", "Account")

					<div class="container">
						<div class="row">
							<div class="col-md-8 col-lg-5 mx-auto">
								@if (BrandingProvider.LogoUrl.IsNullOrEmpty())
								{
									<div class="lpx-logo-container lpx-login-brand-text sync-login-brand">
										<div class="lpx-brand-logo lpx-login-logo"></div>
										<div class="lpx-brand-name lpx-login-name">@appName</div>
									</div>
								}
								else
								{
									<div class="lpx-brand-logo lpx-login-logo mb-3 mx-auto"></div>
								}

								@{
									var headerInCard = ViewData["Sync.HeaderInCard"] is true;
									var hasLanguageSwitch = languageInfo.Languages.Count > 1;
									var hasAlerts = AlertManager.Alerts.Any();
									var hasTenantSwitch = MultiTenancyOptions.Value.IsEnabled
										&& (TenantResolveResultAccessor.Result?.AppliedResolvers?.Contains("Cookie") == true
											|| TenantResolveResultAccessor.Result?.AppliedResolvers?.Contains("QueryString") == true);
								}
								@if (!headerInCard && (hasLanguageSwitch || hasAlerts || hasTenantSwitch))
								{
									<abp-card>
										<abp-card-body>
											<div class="align-items-start d-flex justify-content-between mb-2">
												<h2 class="lpx-main-title lpx-login-title m-0 me-auto"> @PageLayout.Content.Title </h2>
												<partial name="/Themes/LeptonXLite/Layouts/_LanguageSwitch.cshtml" />
											</div>

											<hr />

											@if (hasAlerts)
											{
												@await Component.InvokeAsync(typeof(PageAlertsViewComponent))
											}

											@if (hasTenantSwitch)
											{
												<div class="row">
													<div class="col">
														<span style="font-size: .8em;"
															class="text-uppercase text-muted">@MultiTenancyStringLocalizer["Tenant"]</span><br />
														<h6 class="m-0 d-inline-block">
															@if (!CurrentTenant.Id.HasValue)
															{
																<span>
																	@MultiTenancyStringLocalizer["NotSelected"]
																</span>
															}
															else
															{
																<strong>@(CurrentTenant.Name ?? CurrentTenant.Id.Value.ToString())</strong>
															}
														</h6>
													</div>
													<div class="col-auto">
														<a id="AbpTenantSwitchLink" href="javascript:;"
														class="btn btn-sm btn-outline-primary">@MultiTenancyStringLocalizer["Switch"]</a>
													</div>
												</div>
											}
										</abp-card-body>
									</abp-card>
								}

								@RenderBody()

								@await Component.InvokeLayoutHookAsync("PageContent.Last", "Account")
							</div>
						</div>
					</div>
				</div>

			</div>

		</div>
	</div>

	<abp-script-bundle name="LeptonXLite.Global" />
	<script src="~/Abp/ApplicationLocalizationScript?cultureName=@CultureInfo.CurrentUICulture.Name"></script>
	<script type="text/javascript" src="~/Abp/ApplicationConfigurationScript"></script>
	<script type="text/javascript" src="~/Abp/ServiceProxyScript"></script>

	@await Component.InvokeAsync(typeof(WidgetScriptsViewComponent))

	@await RenderSectionAsync("scripts", required: false)

	@await Component.InvokeLayoutHookAsync("Body.Last", "Account")
</body>

</html>
