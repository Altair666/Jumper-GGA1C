<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <!-- Порт ядра QLabelSDK (GoLabel II) для EZPL: чтение .ezpx и сборка задания так же, как
       это делает GoLabel, байт в байт. Источник — декомпилят C:\GGA1C\golabel-src (вне git),
       перенос для внутреннего использования — решение пользователя (docs/printing/decisions.md).
       Neodynamic не переносится. Замер шрифтов — GDI+ через P/Invoke (только Windows). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GGA1C.Sync.Printing.GoLabel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GGA1C.Sync.Printing.Core\GGA1C.Sync.Printing.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GGA1C.Sync.Printing.Tests" />
  </ItemGroup>

</Project>
